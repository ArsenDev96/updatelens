# Dependencies (installed via `npm install` / `composer install`; lockfiles are tracked)
node_modules/
/vendor/

# Build output (regenerated by `npm run build` / `npm run release`)
/assets/admin/dist/
/release/
*.tsbuildinfo

# Vite dev-server marker: points the site at localhost while `npm run dev` runs.
# Already covered by /assets/admin/dist/ above; listed so it stays ignored if dist/ is ever tracked.
/assets/admin/dist/vite-dev-server.json

# Local WordPress / Playground runtime
/wordpress/
/.wp-env.override.json

# Local tool overrides
/phpcs.xml
/.claude/settings.local.json

# Logs
*.log
npm-debug.log*

# Temporary files
*.tmp
/tmp/

# Local env / secrets
*.local
.env
.env.*
!.env.example

# Editors / IDEs
.vscode/*
!.vscode/extensions.json
.idea/
*.code-workspace
*.sw?

# OS metadata
.DS_Store
Thumbs.db
desktop.ini

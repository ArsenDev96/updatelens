{
  "name": "updatelens",
  "version": "0.1.0",
  "private": true,
  "description": "Understand what changes when your WordPress plugins update.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "concurrently \"npm run dev\" \"npx @wp-playground/cli@latest server --auto-mount --login\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "release": "npm run build && node scripts/release.mjs",
    "i18n": "wp i18n make-pot . languages/updatelens.pot --domain=updatelens --exclude=node_modules,vendor,release,assets/admin/dist"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kucrut/vite-for-wp": "^0.12.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "@wordpress/api-fetch": "^7.56.0",
    "@wordpress/i18n": "^6.29.0",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.29",
    "postcss-prefix-selector": "^2.2.1",
    "prettier": "npm:wp-prettier@^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "rollup-plugin-external-globals": "^0.13.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vite-plugin-external": "^6.2.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
